// Financials table based on work by finallynitin, EquityCraze & Mohit_Kakkar08

//@version=6
indicator("Setup Scanner – CVD Bull Divergence", shorttitle="Setup", overlay=true, max_bars_back=500, max_labels_count=500)

import PineCoders/lower_tf/2 as PCltf

// ═══════════════════════════════════════════════════════════════
//  LTF STRING CONSTANTS  (must match PCltf.ltf() argument order)
// ═══════════════════════════════════════════════════════════════
string LTF1 = "Least precise, covering most chart bars"
string LTF2 = "Less precise, covering some chart bars"
string LTF3 = "More precise, covering less chart bars"
string LTF4 = "Most precise, 1min intrabars"
string LTF5 = "~12 intrabars per chart bar"
string LTF6 = "~24 intrabars per chart bar"
string LTF7 = "~50 intrabars per chart bar"
string LTF8 = "~100 intrabars per chart bar"

// ═══════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════

string G_CVD = "CVD Settings"
string i_ltfMode = input.string(LTF2, "Intrabar Precision", group=G_CVD,
     options=[LTF1, LTF2, LTF3, LTF4, LTF5, LTF6, LTF7, LTF8],
     tooltip="More precise = fewer chart bars covered (max 100K intrabars total). Matches CVD.pine setting.")

string G_SCAN = "Scan Conditions"
int   i_lookback  = input.int(75,    "Lookback Bars (~2.5 months on daily)", minval=20,  maxval=500,  group=G_SCAN,
     tooltip="On a daily chart ~55–75 bars ≈ 2.5 months.")
int   i_minDivs   = input.int(3,     "Min CVD Bullish Divergences",          minval=1,   maxval=50,   group=G_SCAN,
     tooltip="Minimum count of teal-candle (bullish intrabar CVD divergence) bars in the lookback window.")
float i_pctThresh = input.float(25.0,"Price Range % from High / Low",        minval=1.0, maxval=50.0, step=1.0, group=G_SCAN,
     tooltip="CMP must be within this % below the period high AND within this % above the period low simultaneously.") / 100
float i_bbwThresh = input.float(15.0,"Bollinger Bandwidth Threshold (<)",    minval=1.0, step=0.5,   group=G_SCAN,
     tooltip="Bollinger %Bandwidth = (Upper − Lower) / Basis × 100. Below 15 = tight consolidation.")

string G_VIS = "Visuals"
bool  i_colorSetup = input.bool(true,         "Highlight setup candles",     group=G_VIS)
color i_setupColor = input.color(color.black, "Setup candle color",          group=G_VIS)
color i_divDot     = input.color(color.yellow, "CVD Div dot color",           group=G_VIS)
float i_arrowGap   = input.float(3.0, "Dot gap below candle (%)", minval=0.5, maxval=20.0, step=0.5, group=G_VIS,
     tooltip="How far below the bar low the dot is drawn, as a % of the bar low price.") / 100

string G_EMA = "EMAs"
bool  i_show10   = input.bool(true,                      "Show 10 EMA",    inline="e10", group=G_EMA)
color i_ema10Clr = input.color(color.green,              "",               inline="e10", group=G_EMA)
bool  i_show20   = input.bool(true,                      "Show 20 EMA",    inline="e20", group=G_EMA)
color i_ema20Clr = input.color(color.red,                "",               inline="e20", group=G_EMA)
bool  i_showRS   = input.bool(true,                      "Show RS line",   inline="rs",  group=G_EMA)
string i_idxSym  = input.symbol("NSE:NIFTYSMLCAP250",   "vs",             inline="rs",  group=G_EMA)
int   i_rsPeriod = input.int(20, "RS Period", minval=5, maxval=200,        inline="rs",  group=G_EMA)

string G_FIN = "════ Quarterly Financials ════"
bool   i_darkMode  = input.bool(false,    "Dark Mode",          group=G_FIN, tooltip="Enable for dark chart themes.")
bool   i_miniMode  = input.bool(false,    "Mini Mode",          group=G_FIN, tooltip="Show traffic-light dots instead of values.")
int    i_dataSize  = input.int(4,         "Quarters to show",   group=G_FIN, minval=1, maxval=12) + 5
string i_tblSize   = input.string("normal","Table Size",        group=G_FIN, options=["tiny","small","normal","large","huge","auto"], inline="tbl")
string i_tblPosY   = input.string("bottom","↕",                 group=G_FIN, options=["top","middle","bottom"],                       inline="tbl")
string i_tblPosX   = input.string("right", "↔",                 group=G_FIN, options=["left","center","right"],                       inline="tbl")
string i_finPer    = input.string("FQ",   "Period",             group=G_FIN, options=["FQ","FY"], tooltip="FQ = quarterly, FY = annual.")
string i_topLeft   = input.string("FF",   "Top-left cell",      group=G_FIN, options=["FF","Mcap"], tooltip="Free Float (FF) or Market Cap.")

// ═══════════════════════════════════════════════════════════════
//  REAL CVD — identical intrabar logic to CVD.pine
//  Determines up/down volume for each intrabar candle.
// ═══════════════════════════════════════════════════════════════

upDnIntrabarVolumes() =>
    float upVol = 0.0
    float dnVol = 0.0
    float prevClose = nz(close[1])
    float prevUp    = nz(upVol[1])
    float prevDn    = nz(dnVol[1])
    switch
        close > open    => upVol += volume
        close < open    => dnVol -= volume
        close > prevClose => upVol += volume
        close < prevClose => dnVol -= volume
        prevUp > 0      => upVol += volume
        prevDn < 0      => dnVol -= volume
        =>              na  // default: no volume assignment
    [upVol, dnVol]

var string ltfString = PCltf.ltf(i_ltfMode, LTF1, LTF2, LTF3, LTF4, LTF5, LTF6, LTF7, LTF8)

[upVolumes, dnVolumes] = request.security_lower_tf(syminfo.tickerid, ltfString, upDnIntrabarVolumes())

float totalUpVol = nz(array.sum(upVolumes))
float totalDnVol = nz(array.sum(dnVolumes))
float delta      = totalUpVol + totalDnVol   // positive = net buying, negative = net selling

// ─── Teal candle condition from CVD.pine ──────────────────────
// divergence = delta direction conflicts with price bar direction
// teal (bullish) = net buying pressure (delta > 0) on a bearish price candle
bool cvdDivergence = delta != 0 and math.sign(delta) != math.sign(close - open)
bool bullishCvdDiv = delta > 0 and cvdDivergence

// ═══════════════════════════════════════════════════════════════
//  EMAs
// ═══════════════════════════════════════════════════════════════

float ema10 = ta.ema(close, 10)
float ema20 = ta.ema(close, 20)

// ═══════════════════════════════════════════════════════════════
//  RELATIVE STRENGTH vs BENCHMARK
// ═══════════════════════════════════════════════════════════════

float idxClose = request.security(i_idxSym, timeframe.period, close)
float stockChg = nz(close    / close[i_rsPeriod]    - 1, 0.0)
float idxChg   = nz(idxClose / idxClose[i_rsPeriod] - 1, 0.0)
bool  isOut    = stockChg > idxChg

// ═══════════════════════════════════════════════════════════════
//  BOLLINGER %BANDWIDTH
//  Formula: (Upper − Lower) / Basis × 100
// ═══════════════════════════════════════════════════════════════

float bbBasis = ta.sma(close, 20)
float bbDev   = ta.stdev(close, 20)
float bbWidth = (4.0 * bbDev) / bbBasis * 100

// ═══════════════════════════════════════════════════════════════
//  PRICE RANGE CONDITIONS  (2.5-month rolling window)
// ═══════════════════════════════════════════════════════════════

float high2m5  = ta.highest(high, i_lookback)
float low2m5   = ta.lowest(low,   i_lookback)
bool  nearHigh = close >= high2m5 * (1.0 - i_pctThresh) and close <= high2m5
bool  nearLow  = close <= low2m5  * (1.0 + i_pctThresh) and close >= low2m5

// ═══════════════════════════════════════════════════════════════
//  DIVERGENCE COUNT IN LOOKBACK WINDOW
// ═══════════════════════════════════════════════════════════════

float divCount   = math.sum(bullishCvdDiv ? 1.0 : 0.0, int(i_lookback))
bool  enoughDivs = divCount >= i_minDivs

// ═══════════════════════════════════════════════════════════════
//  AGGREGATE SETUP CONDITION
// ═══════════════════════════════════════════════════════════════

bool aboveEma20  = close > ema20
bool bbwNarrow   = bbWidth < i_bbwThresh
bool setupActive = nearHigh and nearLow and enoughDivs and aboveEma20 and bbwNarrow

// ═══════════════════════════════════════════════════════════════
//  QUARTERLY FINANCIALS TABLE
// ═══════════════════════════════════════════════════════════════

color _frameCol = i_darkMode ? color.new(#999999, 50)           : color.rgb(241, 241, 241)
color _textClr  = i_darkMode ? color.new(color.white, 0)        : color.new(color.black, 0)
color _bgClr    = i_darkMode ? color.new(color.white, 100)      : color.new(color.black, 100)
color _hdClr    = i_darkMode ? color.new(#444444, 0)            : color.new(#d0d0d0, 0)
color _upClr    = i_darkMode ? color.new(color.lime, 0)         : color.new(color.rgb(31, 12, 239, 16), 0)
color _dnClr    = i_darkMode ? color.new(color.red, 0)          : color.new(color.rgb(213, 27, 182), 10)
color _flatClr  = i_darkMode ? color.new(color.yellow, 0)       : color.new(color.orange, 30)

string _EPS_ID  = "EARNINGS_PER_SHARE_DILUTED"
string _REV_ID  = "TOTAL_REVENUE"

_getFinancial(_id, _per) =>
    float _val = request.financial(syminfo.tickerid, _id, _per, barmerge.gaps_on, ignore_invalid_symbol=true)
    if _id == _REV_ID
        _val := math.round(_val / 10.0, 2)
    _val

_pushArray(arr, val) =>
    array.unshift(arr, val)
    array.pop(arr)

float _revRef = request.financial(syminfo.tickerid, _REV_ID, i_finPer, barmerge.gaps_on, ignore_invalid_symbol=true)

var array<int>   _dates   = array.new_int(i_dataSize)
var array<float> _epsArr  = array.new_float(i_dataSize)
var array<float> _revArr  = array.new_float(i_dataSize)

if not na(_revRef)
    _pushArray(_dates,  time)
    _pushArray(_epsArr, _getFinancial(_EPS_ID, i_finPer))
    _pushArray(_revArr, _getFinancial(_REV_ID, i_finPer))

// Free Float
float _ff_raw   = nz(request.financial(syminfo.tickerid, "FLOAT_SHARES_OUTSTANDING", "FY"))
float _ff       = na(ta.vwap) ? _ff_raw / 10000000 : _ff_raw * ta.vwap / 10000000
string _ff_str  = na(_ff) or nz(_ff) == 0 ? "" : str.tostring(math.round(_ff)) + " Cr"

// Market Cap
float _mc_raw   = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ")
float _mc       = _mc_raw * close / 10000000
string _mc_str  = na(_mc) or nz(_mc) == 0 ? "" : str.tostring(math.round(_mc, 0)) + " Cr"

string _topLeftVal = i_topLeft == "FF" ? _ff_str : _mc_str

_ftHead(_t, _col, _row, _txt) =>
    table.cell(_t, _col, _row, _txt, bgcolor=_hdClr, text_color=_textClr, text_size=i_tblSize)

_ftDate(_t, _col, _row, _txt) =>
    string _v = str.contains(_txt, "70") ? "" : _txt
    table.cell(_t, _col, _row, _v, bgcolor=_bgClr, text_color=_textClr, text_size=i_tblSize, text_halign=text.align_left)

_ftVal(_isEps, _t, _col, _row, _arr, _i) =>
    float _raw = array.get(_arr, _i)
    float _val = _isEps ? _raw / 1 : _raw / 1
    string _fmt = _isEps ? "#.##" : "#,###.##"
    string _txt = na(_val) ? "" : str.tostring(_val, _fmt)
    table.cell(_t, _col, _row, _txt, text_color=_textClr, text_size=i_tblSize)

_ftYoY(_t, _col, _row, _arr, _i, _cmpr) =>
    float _v1 = array.get(_arr, _i)
    float _v2 = array.get(_arr, _i + _cmpr)
    _v1 := _v1 == 0 ? 1 : _v1
    _v2 := math.round(_v2, 1) == 0 ? 0.1 : _v2
    float _dif = math.round((_v1 - _v2) / math.abs(_v2) * 100)
    string _sym = na(_dif) ? "" : _dif > 0 ? "+" + str.tostring(_dif) + "%" : str.tostring(_dif) + "%"
    color  _clr = na(_dif) ? _frameCol : _dif > 0 ? _upClr : _dif < 0 ? _dnClr : _flatClr
    string _txt = na(_dif) ? "●" : i_miniMode ? "●" : _sym
    table.cell(_t, _col, _row, _txt, text_halign=text.align_right, text_color=_clr, text_size=i_tblSize)

var table _finTbl = table.new(i_tblPosY + "_" + i_tblPosX, columns=4, rows=i_dataSize,
     bgcolor=_bgClr, frame_color=_frameCol, frame_width=1, border_color=_frameCol, border_width=1)

if barstate.islast
    if not i_miniMode
        _ftHead(_finTbl, 0, 0, "Quarter")
        _ftHead(_finTbl, 1, 0, "EPS")
        _ftHead(_finTbl, 2, 0, i_finPer == "FY" ? "YoY" : "%Chg")
        _ftHead(_finTbl, 3, 0, i_finPer == "FY" ? "Sales YoY" : "Sales %Chg")

        for i = 0 to i_dataSize - 5
            _ftDate(_finTbl, 0, i+1, str.format("{0, date, MMM-yy}", array.get(_dates, i)))
            _ftVal(true,  _finTbl, 1, i+1, _epsArr, i)
            _ftYoY(_finTbl, 2, i+1, _epsArr, i, i_finPer == "FY" ? 1 : 4)
            _ftYoY(_finTbl, 3, i+1, _revArr, i, i_finPer == "FY" ? 1 : 4)
    else
        for i = 0 to i_dataSize - 5
            _ftDate(_finTbl, 0, i+1, str.format("{0, date, MMM-yy}", array.get(_dates, i)))
            _ftYoY(_finTbl, 2, i+1, _epsArr, i, i_finPer == "FY" ? 1 : 4)
            _ftYoY(_finTbl, 3, i+1, _revArr, i, i_finPer == "FY" ? 1 : 4)

// ═══════════════════════════════════════════════════════════════
//  VISUALS
// ═══════════════════════════════════════════════════════════════

if bullishCvdDiv
    label.new(x=bar_index, y=low*(1.0-i_arrowGap), text="", style=label.style_circle, color=i_divDot, size=size.small)

plot(i_show10 ? ema10 : na, "10 EMA", i_ema10Clr, linewidth=1)
plot(i_show20 ? ema20 : na, "20 EMA", i_ema20Clr, linewidth=1)

color _rsClr = isOut ? color.new(color.green, 0) : color.new(color.red, 0)
plotshape(i_showRS, "RS Line", shape.square, location.top, _rsClr, size=size.small)

// Paint candles black only within the configured lookback window.
bool inWindow = bar_index >= last_bar_index - i_lookback
barcolor(i_colorSetup and setupActive and inWindow ? i_setupColor : na)
