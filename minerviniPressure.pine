//@version=6
// WHAT THIS DOES (plain English)
// ─────────────────────────────────────────────
// Every day the market is either being "accumulated" (smart money buying)
// or "distributed" (smart money selling). This indicator tries to measure that.
//
// It looks at the volume on up-days vs down-days over a chosen period (default 20 days).
//   • If most volume happened on up-days → buyers are in control → positive reading
//   • If most volume happened on down-days → sellers are in control → negative reading
//
// The result is a score from -100 to +100:
//   > +30  → Strong Accumulation (heavy buying pressure)
//     0–30 → Mild Accumulation
//     0    → Neutral / balanced
//   -30–0  → Mild Distribution
//   < -30  → Strong Distribution (heavy selling pressure)
//
// Optional "Body/Range Weighting": instead of using full volume, it scales each
// day's volume by how decisive the candle was (big body = strong conviction).
// ─────────────────────────────────────────────
indicator("Minervini Pressure", shorttitle="Minervini Pressure", overlay=false)

//─────────────────────────────────────────────
// INPUTS
//─────────────────────────────────────────────
lookback = input.int(20, "Lookback", minval=1)

useWeighted = input.bool(
     false,
     "Body/Range Weighting",
     tooltip="Off = classic up-volume vs down-volume. On = volume is weighted by candle body/range."
)

showHistogram = input.bool(true, "Histogram")

//─────────────────────────────────────────────
// CLASSIC PRESSURE
//─────────────────────────────────────────────
// Up day  = Close > Open
// Down day = Close < Open
//
// Pressure =
// (Up Volume - Down Volume)
// ------------------------- × 100
// (Up Volume + Down Volume)

// Volume on up days
upVolume = close > open ? volume : 0.0

// Volume on down days
downVolume = close < open ? volume : 0.0

// Sum over lookback
totalUpVolume = math.sum(upVolume, lookback)
totalDownVolume = math.sum(downVolume, lookback)

// Classic pressure
classicPressure = totalUpVolume + totalDownVolume > 0 ?
     (totalUpVolume - totalDownVolume) /
     (totalUpVolume + totalDownVolume) * 100.0 :
     na

//─────────────────────────────────────────────
// WEIGHTED PRESSURE
//─────────────────────────────────────────────
// Weight = candle body / candle range
//
// Example:
// Open 100
// High 110
// Low   95
// Close 108
//
// Body  = 8
// Range = 15
// Weight = 8/15 = 0.533

candleRange = high - low
body = math.abs(close - open)

bodyWeight = candleRange > 0 ?
     body / candleRange :
     0.0

weightedUpVolume =
     close > open ?
     volume * bodyWeight :
     0.0

weightedDownVolume =
     close < open ?
     volume * bodyWeight :
     0.0

totalWeightedUpVolume =
     math.sum(weightedUpVolume, lookback)

totalWeightedDownVolume =
     math.sum(weightedDownVolume, lookback)

weightedPressure =
     totalWeightedUpVolume + totalWeightedDownVolume > 0 ?
     (totalWeightedUpVolume - totalWeightedDownVolume) /
     (totalWeightedUpVolume + totalWeightedDownVolume) * 100.0 :
     na

//─────────────────────────────────────────────
// SELECT PRESSURE TYPE
//─────────────────────────────────────────────
float pressure = useWeighted ?
     weightedPressure :
     classicPressure

//─────────────────────────────────────────────
// PRESSURE COLOR
//─────────────────────────────────────────────
pressureColor =
     pressure > 30 ? color.lime :
     pressure > 0  ? color.green :
     pressure > -30 ? color.orange :
     color.red

//─────────────────────────────────────────────
// PLOT
//─────────────────────────────────────────────
plot(
     pressure,
     title="Pressure %",
     style=showHistogram ? plot.style_columns : plot.style_line,
     color=pressureColor,
     linewidth=2
)

// Reference levels
hline(0, "Zero", color=color.gray, linestyle=hline.style_dotted)

hline(
     30,
     "Strong Accumulation",
     color=color.green,
     linestyle=hline.style_dashed
)

hline(
     -30,
     "Strong Distribution",
     color=color.red,
     linestyle=hline.style_dashed
)

//─────────────────────────────────────────────
// INFORMATION TABLE
//─────────────────────────────────────────────
var table t = table.new(
     position.top_right,
     2,
     4,
     border_width=1
)

if barstate.islast

    table.cell(
         t,
         0,
         0,
         "Pressure",
         text_color=color.white,
         bgcolor=color.gray
    )

    table.cell(
         t,
         1,
         0,
         str.tostring(pressure, "#.##") + "%",
         text_color=pressure >= 0 ? color.lime : color.red
    )

    table.cell(
         t,
         0,
         1,
         "Method",
         text_color=color.white,
         bgcolor=color.gray
    )

    table.cell(
         t,
         1,
         1,
         useWeighted ? "Weighted" : "Classic",
         text_color=chart.fg_color
    )

    table.cell(
         t,
         0,
         2,
         "Lookback",
         text_color=color.white,
         bgcolor=color.gray
    )

    table.cell(
         t,
         1,
         2,
         str.tostring(lookback) + " days",
         text_color=chart.fg_color
    )

    string interpretation =
         pressure > 30 ? "Strong Accumulation" :
         pressure > 10 ? "Accumulation" :
         pressure > -10 ? "Neutral" :
         pressure > -30 ? "Distribution" :
         "Strong Distribution"

    table.cell(
         t,
         0,
         3,
         "Signal",
         text_color=color.white,
         bgcolor=color.gray
    )

    table.cell(
         t,
         1,
         3,
         interpretation,
         text_color=pressure >= 0 ? color.lime : color.red
    )