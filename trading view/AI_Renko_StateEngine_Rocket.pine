//@version=6
indicator("AI Renko Supertrend + Trend State Engine", shorttitle="Renko Rocket", overlay=true, max_bars_back=1000)

// Merge of "AI Renko Supertrend" (trend colour / line) and "Adaptive Trend State Engine 3.0" (state machine).
// ENTRY : engine turns bullish/bearish AND the Renko Supertrend agrees -> rocket of stacked triangles.
// EXIT  : engine leaves the state (back to neutral / opposite) or, optionally, Renko flips against the trade.

//=====================================================================
// 1. INPUTS - Renko Supertrend
//=====================================================================
atrLen     = input.int(10, "ATR Length", minval = 1, maxval = 50)
baseFactor = input.float(3.0, "Base Factor", minval = 0.5, maxval = 8.0, step = 0.1)
autoBox    = input.bool(true, "Auto Brick Size")
manualBox  = input.float(10.0, "Manual Brick Size", minval = 0.01, step = 0.01)
lateOn     = input.bool(true, "Grey out late signals", group = "Late Signal")
lateHour   = input.int(14, "Cutoff Hour (exchange time, 0-23)", minval = 0, maxval = 23, group = "Late Signal")
lateMin    = input.int(30, "Cutoff Minute", minval = 0, maxval = 59, group = "Late Signal")
lateCol    = input.color(color.gray, "Late Signal Color", group = "Late Signal")
blockLate  = input.bool(true, "Block new entries after cutoff time (exits still allowed)", group = "Late Signal")
skipFirst  = input.bool(true, "Skip entries on the day's first candle", group = "Late Signal")

bullCol = input.color(#008000, "Bull", group = "Style")
bearCol = input.color(#FF0000, "Bear", group = "Style")
paintGradient = input.bool(true, "Paint Trend Gradient Fill", group = "Style", tooltip = "Fade-out colour fill between the Supertrend and the candle.")

//=====================================================================
// 2. INPUTS - Trend State Engine
//=====================================================================
groupKalman = "1. Two-State Kalman Filter"
volLen = input.int(20, "Volatility Lookback", minval=5, maxval=100, group=groupKalman)
observationBase = input.float(1.0, "Observation Noise", minval=0.1, maxval=10.0, step=0.1, group=groupKalman)
processNoise = input.float(0.05, "Process Noise", minval=0.001, maxval=2.0, step=0.005, group=groupKalman)
spikeSensitivity = input.float(2.0, "Spike Noise Sensitivity", minval=0.0, maxval=10.0, step=0.1, group=groupKalman)

groupTrend = "2. Trend Detection"
efficiencyLen = input.int(12, "Efficiency Lookback", minval=3, maxval=100, group=groupTrend)
velocityScale = input.float(1.5, "Velocity Scale", minval=0.1, maxval=10.0, step=0.1, group=groupTrend)
displacementScale = input.float(2.0, "Displacement Scale", minval=0.1, maxval=10.0, step=0.1, group=groupTrend)
weightVelocity = input.float(0.60, "Velocity Weight", minval=0.0, maxval=1.0, step=0.05, group=groupTrend)
weightEfficiency = input.float(0.25, "Efficiency Weight", minval=0.0, maxval=1.0, step=0.05, group=groupTrend)
weightDisplacement = input.float(0.15, "Displacement Weight", minval=0.0, maxval=1.0, step=0.05, group=groupTrend)

groupAdaptive = "3. Adaptive Thresholds (NEW)"
bandLen = input.int(20, "Adaptive Lookback", minval=5, maxval=100, group=groupAdaptive, tooltip="Lookback for dynamic thresholds.")
entryBandMult = input.float(1.5, "Entry Band Multiplier", minval=0.1, maxval=5.0, step=0.1, group=groupAdaptive, tooltip="Lower multiplier = earlier entries. Higher = safer entries.")
exitBandMult = input.float(0.0, "Exit Band Multiplier (0 = Mean)", minval=-2.0, maxval=2.0, step=0.1, group=groupAdaptive)
minThreshold = input.float(0.10, "Minimum Absolute Threshold", minval=0.01, maxval=0.50, step=0.01, group=groupAdaptive, tooltip="Prevents fakeouts during completely dead markets.")

groupState = "4. State Machine"
confirmBars = input.int(1, "Consecutive Confirmation Bars", minval=1, maxval=10, group=groupState)

//=====================================================================
// 3. INPUTS - Rocket / Exit display
//=====================================================================
groupRocket = "Rocket Signals"
showRockets  = input.bool(true, "Show Entry Rockets", group=groupRocket)
rocketCount  = input.int(6, "Triangles per Rocket", minval=3, maxval=6, group=groupRocket)
rocketMargin = input.float(0.8, "Gap from Candle (x ATR)", minval=0.0, maxval=5.0, step=0.1, group=groupRocket)
rocketStep   = input.float(0.22, "Triangle Spacing (x ATR, equal between all)", minval=0.05, maxval=3.0, step=0.05, group=groupRocket)
catchUp      = input.bool(true, "Enter when Renko agrees later (engine already in state)", group=groupRocket, tooltip="Off = signal only on the exact bar the engine flips. On = also fires if Renko turns to match while the engine is still in that state.")
exitOnRenko  = input.bool(true, "Exit when Renko flips against trade", group=groupRocket)
showExits    = input.bool(true, "Show Exit Markers", group=groupRocket)
limitDaily   = input.bool(true, "Limit entries per day (no new signal after the limit until next session)", group=groupRocket)
maxPerDay    = input.int(1, "Max Entries per Day", minval=1, maxval=20, group=groupRocket)
showSupertrend = input.bool(true, "Show Supertrend Line / Fill", group=groupRocket)
exitCol      = input.color(color.orange, "Exit Color", group=groupRocket)
useVwap      = input.bool(true, "Require price above VWAP (long) / below VWAP (short)", group=groupRocket)
showVwap     = input.bool(true, "Plot VWAP", group=groupRocket)



//=====================================================================
// 4. RENKO SUPERTREND CORE
//=====================================================================
// ───────────────────────── Helpers ─────────────────────────
// RMA seeded with the first value (matches the original helper), holds previous value on na input
f_rma(float x, int len) =>
    float r = na
    r := na(x) ? r[1] : na(r[1]) ? x : r[1] + (x - r[1]) / math.max(1, len)
    r

// ───────────────────────── Adaptive ATR ─────────────────────────
longLen  = 3 * atrLen
shortLen = math.max(atrLen - 4, 5)
slowLen  = math.min(atrLen + 4, 40)

tr = ta.tr(true)
atrBase  = f_rma(tr, atrLen)
atrLong  = f_rma(tr, longLen)
atrShort = f_rma(tr, shortLen)
atrSlow  = f_rma(tr, slowLen)

ready    = bar_index >= longLen - 1 and not na(atrBase) and not na(atrLong) and atrLong != 0
ratio    = ready ? atrBase / atrLong : 1.0
highVol  = ready and ratio > 1.2
lowVol   = ready and ratio < 0.8

adaptAtr = ready ? (highVol ? atrShort : lowVol ? atrSlow : atrBase) : na
factor   = highVol ? baseFactor + 1 : lowVol ? math.max(baseFactor - 0.5, 1.5) : baseFactor
brick    = autoBox ? adaptAtr * (highVol ? 1.5 : lowVol ? 0.7 : 1.0) : manualBox

// ───────────────────────── Renko state ─────────────────────────
var float rClose = na   // last renko brick close
var float rOpen  = na   // previous brick close
var float rHigh  = na
var float rLow   = na

float prevClose = rClose
if ready and brick > 0
    if na(prevClose)
        rClose := close
        rOpen  := close
        rHigh  := close
        rLow   := close
    else if close >= rClose + brick
        n = math.floor((close - rClose) / brick)
        rOpen  := rClose
        rClose := rClose + n * brick
        rHigh  := rClose
        rLow   := rOpen
    else if close <= rClose - brick
        n = math.floor((rClose - close) / brick)
        rOpen  := rClose
        rClose := rClose - n * brick
        rHigh  := rOpen
        rLow   := rClose
else
    rClose := close
    rOpen  := close
    rHigh  := close
    rLow   := close

// ───────────────────────── Supertrend on renko ─────────────────────────
brickRange = ready and brick > 0 ? nz(rHigh - rLow, brick) : na
renkoAtr   = f_rma(brickRange, atrLen)
mid        = (nz(rHigh) + nz(rLow)) / 2
upper      = na(renkoAtr) ? na : mid + factor * renkoAtr
lower      = na(renkoAtr) ? na : mid - factor * renkoAtr

var float finalUpper = na
var float finalLower = na
var float stLine     = na
var int   dir        = na

float pUpper = finalUpper
float pLower = finalLower
float pLine  = stLine
int   pDir   = dir

finalUpper := na(pUpper) or (not na(upper) and (upper < pUpper or nz(prevClose) > pUpper)) ? upper : pUpper
finalLower := na(pLower) or (not na(lower) and (lower > pLower or nz(prevClose) < pLower)) ? lower : pLower

degenerate = (not na(renkoAtr) and renkoAtr <= 0) or (not na(upper) and not na(lower) and upper == lower)

dir := na(pLine) ? 1 : degenerate ? (na(pDir) ? 1 : pDir) : nz(pLine) == nz(pUpper) ? (rClose > finalUpper ? 1 : -1) : (rClose < finalLower ? -1 : 1)
stLine := dir == 1 ? finalLower : finalUpper

//=====================================================================
// 5. TREND STATE ENGINE CORE
//=====================================================================
weightSum = weightVelocity + weightEfficiency + weightDisplacement
validWeights = weightSum > 0.0

price = math.log(close)
logReturn = na(price[1]) ? 0.0 : price - price[1]
volatility = ta.ema(math.abs(logReturn), volLen)
volFloor = 0.000001
safeVol = math.max(nz(volatility, volFloor), volFloor)

var float level = na
var float velocity = 0.0
var float p00 = na
var float p01 = 0.0
var float p11 = na

float predictedLevel = na(level) ? price : level + velocity
float predictedVelocity = velocity
float innovation = price - predictedLevel
float normalizedInnovation = innovation / safeVol
float boundedInnovation = math.max(-10.0, math.min(10.0, normalizedInnovation))

float noiseMultiplier = 1.0 + spikeSensitivity * math.max(0.0, math.abs(boundedInnovation) - 1.0)
float measurementNoise = observationBase * noiseMultiplier * safeVol * safeVol

float q = processNoise * safeVol * safeVol
float q00 = q * 0.25
float q01 = q * 0.50
float q11 = q

float predP00 = na(p00) ? safeVol * safeVol : p00 + 2.0 * p01 + p11 + q00
float predP01 = na(p01) or na(p00) ? 0.0 : p01 + p11 + q01
float predP11 = na(p11) ? safeVol * safeVol * 0.1 : p11 + q11

float innovationVariance = math.max(predP00 + measurementNoise, 0.000000000001)
float k0 = predP00 / innovationVariance
float k1 = predP01 / innovationVariance

if barstate.isconfirmed
    if na(level)
        level := price
        velocity := 0.0
        p00 := safeVol * safeVol
        p01 := 0.0
        p11 := safeVol * safeVol * 0.1
    else
        level := predictedLevel + k0 * innovation
        velocity := predictedVelocity + k1 * innovation
        p00 := math.max((1.0 - k0) * predP00, 0.0)
        p01 := (1.0 - k0) * predP01
        p11 := math.max(predP11 - k1 * predP01, 0.0)

netMovement = math.abs(price - price[efficiencyLen])
totalMovement = math.sum(math.abs(logReturn), efficiencyLen)
efficiency = not na(totalMovement) and totalMovement > 0.0 ? math.min(1.0, netMovement / totalMovement) : 0.0

normalizedVelocity = nz(velocity, 0.0) / safeVol
velocityArgument = math.max(-10.0, math.min(10.0, normalizedVelocity / velocityScale))
velocityFeature = 2.0 / (1.0 + math.exp(-2.0 * velocityArgument)) - 1.0

normalizedDisplacement = (price - nz(level, price)) / safeVol
displacementArgument = math.max(-10.0, math.min(10.0, normalizedDisplacement / displacementScale))
displacementFeature = 2.0 / (1.0 + math.exp(-2.0 * displacementArgument)) - 1.0

wv = validWeights ? weightVelocity / weightSum : 0.0
we = validWeights ? weightEfficiency / weightSum : 0.0
wd = validWeights ? weightDisplacement / weightSum : 0.0

trendScore = wv * velocityFeature + we * (velocityFeature * efficiency) + wd * displacementFeature
trendScore := math.max(-1.0, math.min(1.0, trendScore))

//=====================================================================
// 3. ADAPTIVE DYNAMIC THRESHOLDS
//=====================================================================
scoreSma = ta.sma(trendScore, bandLen)
scoreDev = ta.stdev(trendScore, bandLen)

// Calculate dynamic thresholds, clamped by a minimum value to prevent noise entries
dynBullEnter = math.max(minThreshold, scoreSma + (scoreDev * entryBandMult))
dynBearEnter = math.min(-minThreshold, scoreSma - (scoreDev * entryBandMult))
dynBullExit = scoreSma + (scoreDev * exitBandMult)
dynBearExit = scoreSma - (scoreDev * exitBandMult)

//=====================================================================
// 4. STATE MACHINE (ADAPTIVE)
//=====================================================================
var int trendState = 0
var int pendingState = 0
var int pendingCount = 0

int previousState = trendState
int desiredState = previousState

if validWeights
    if previousState == 1
        if trendScore <= dynBearEnter
            desiredState := -1
        else if trendScore <= dynBullExit
            desiredState := 0
    else if previousState == -1
        if trendScore >= dynBullEnter
            desiredState := 1
        else if trendScore >= dynBearExit
            desiredState := 0
    else
        if trendScore >= dynBullEnter
            desiredState := 1
        else if trendScore <= dynBearEnter
            desiredState := -1

if barstate.isconfirmed
    if desiredState == previousState
        pendingState := previousState
        pendingCount := 0
    else
        if desiredState == pendingState
            pendingCount += 1
        else
            pendingState := desiredState
            pendingCount := 1

        if pendingCount >= confirmBars
            trendState := pendingState
            pendingCount := 0
        else
            trendState := previousState

bullishFlip = barstate.isconfirmed and trendState == 1 and previousState != 1
bearishFlip = barstate.isconfirmed and trendState == -1 and previousState != -1
neutralFlip = barstate.isconfirmed and trendState == 0 and previousState != 0


//=====================================================================
// 6. COMBINED SIGNALS (entry / exit)
//=====================================================================
valid  = ready and brick > 0 and renkoAtr > 0 and rHigh != rLow
isBull = dir == 1

tz       = syminfo.timezone
minOfDay = hour(time, tz) * 60 + minute(time, tz)
isLate   = lateOn and (minOfDay >= lateHour * 60 + lateMin)
pastCutoff = minOfDay >= lateHour * 60 + lateMin
newDay   = dayofmonth(time, tz) != dayofmonth(time[1], tz)
noNewEntry = (blockLate and pastCutoff) or (skipFirst and newDay)
flipped  = nz(pDir, dir) != dir
var bool lateTrend = false
lateTrend := flipped ? isLate : newDay ? false : lateTrend

var int pos = 0          // 1 = long active, -1 = short active
int prevPos = pos

sessVwap = ta.vwap(hlc3)
vwapBull = not useVwap or (not na(sessVwap) and close > sessVwap)
vwapBear = not useVwap or (not na(sessVwap) and close < sessVwap)

bullAligned = valid and trendState == 1  and dir == 1  and vwapBull
bearAligned = valid and trendState == -1 and dir == -1 and vwapBear

longExit  = prevPos == 1  and (trendState != 1  or (exitOnRenko and valid and dir == -1))
shortExit = prevPos == -1 and (trendState != -1 or (exitOnRenko and valid and dir == 1))

rawLongEntry  = not noNewEntry and not longExit  and prevPos != 1  and bullAligned and (bullishFlip or catchUp)
rawShortEntry = not noNewEntry and not shortExit and prevPos != -1 and bearAligned and (bearishFlip or catchUp)

var int entriesToday = 0
if newDay
    entriesToday := 0
dailyOk    = not limitDaily or entriesToday < maxPerDay
longEntry  = rawLongEntry  and dailyOk
shortEntry = rawShortEntry and dailyOk
if longEntry or shortEntry
    entriesToday += 1

if longEntry
    pos := 1
else if shortEntry
    pos := -1
else if longExit or shortExit
    pos := 0

//=====================================================================
// 7. PLOTTING (on chart)
//=====================================================================
col = lateTrend ? lateCol : isBull ? bullCol : bearCol

stPlot    = plot(showSupertrend and valid ? stLine : na, "Supertrend Line", color = col, linewidth = 2, style = plot.style_linebr)
closePlot = plot(showSupertrend and valid ? close : na, "Close (fill ref)", display = display.none, editable = false)

// Crystal gradient: solid trend colour hugging the Supertrend, fading to clear at the candle.
stV     = nz(stLine, close)
fadeReach = 0.55   // fraction of the ST->candle distance over which the colour fades out (lower = fainter near candle)
clearAt = stV + (close - stV) * fadeReach
fillTop = math.max(clearAt, stV)
fillBot = math.min(clearAt, stV)
nearST  = color.new(col, 55)
atCandle = color.new(col, 100)
topCol  = not paintGradient ? na : isBull ? atCandle : nearST   // bull: ST is below price, bear: ST is above price
botCol  = not paintGradient ? na : isBull ? nearST   : atCandle
fill(closePlot, stPlot, fillTop, fillBot, topCol, botCol, title = "Trend Crystal Gradient")

// Faint glass edge: thin brighter band right on the Supertrend line
glowHi = plot(showSupertrend and valid ? stLine + (isBull ? 1 : 0) * brick * 0.15 : na, display = display.none, editable = false)
glowLo = plot(showSupertrend and valid ? stLine - (isBull ? 0 : 1) * brick * 0.15 : na, display = display.none, editable = false)
fill(glowHi, glowLo, color = color.new(col, 78), title = "Crystal Edge")

plot(showVwap ? sessVwap : na, "VWAP", color = color.new(color.orange, 20), linewidth = 1, style = plot.style_linebr)

// Rocket: stacked triangles. Bull = pointing up below the candle, Bear = pointing down above it.
dispAtr = nz(ta.atr(14), high - low)
bullBase = low  - dispAtr * rocketMargin
bearBase = high + dispAtr * rocketMargin
bullOn = showRockets and longEntry
bearOn = showRockets and shortEntry

// Gradient across the stack: triangle nearest the candle is green (bull) / red (bear), fading to dark at the far tip
f_rocketCol(int i, color c0, color c1) =>
    float t = rocketCount > 1 ? i / (rocketCount - 1.0) : 0.0
    color.from_gradient(t, 0.0, 1.0, c0, c1)

darkCol  = color.new(#0b1f14, 0)
bullTop  = color.lime
bearTop  = color.red

plotshape(bullOn ? bullBase : na, "Bull Rocket 1", shape.triangleup, location.absolute, f_rocketCol(0, bullTop, darkCol), size=size.tiny)
plotshape(bullOn ? bullBase - dispAtr * rocketStep * 1 : na, "Bull Rocket 2", shape.triangleup, location.absolute, f_rocketCol(1, bullTop, darkCol), size=size.tiny)
plotshape(bullOn ? bullBase - dispAtr * rocketStep * 2 : na, "Bull Rocket 3", shape.triangleup, location.absolute, f_rocketCol(2, bullTop, darkCol), size=size.tiny)
plotshape(bullOn and rocketCount >= 4 ? bullBase - dispAtr * rocketStep * 3 : na, "Bull Rocket 4", shape.triangleup, location.absolute, f_rocketCol(3, bullTop, darkCol), size=size.tiny)
plotshape(bullOn and rocketCount >= 5 ? bullBase - dispAtr * rocketStep * 4 : na, "Bull Rocket 5", shape.triangleup, location.absolute, f_rocketCol(4, bullTop, darkCol), size=size.tiny)
plotshape(bullOn and rocketCount >= 6 ? bullBase - dispAtr * rocketStep * 5 : na, "Bull Rocket 6", shape.triangleup, location.absolute, f_rocketCol(5, bullTop, darkCol), size=size.tiny)

plotshape(bearOn ? bearBase : na, "Bear Rocket 1", shape.triangledown, location.absolute, f_rocketCol(0, bearTop, darkCol), size=size.tiny)
plotshape(bearOn ? bearBase + dispAtr * rocketStep * 1 : na, "Bear Rocket 2", shape.triangledown, location.absolute, f_rocketCol(1, bearTop, darkCol), size=size.tiny)
plotshape(bearOn ? bearBase + dispAtr * rocketStep * 2 : na, "Bear Rocket 3", shape.triangledown, location.absolute, f_rocketCol(2, bearTop, darkCol), size=size.tiny)
plotshape(bearOn and rocketCount >= 4 ? bearBase + dispAtr * rocketStep * 3 : na, "Bear Rocket 4", shape.triangledown, location.absolute, f_rocketCol(3, bearTop, darkCol), size=size.tiny)
plotshape(bearOn and rocketCount >= 5 ? bearBase + dispAtr * rocketStep * 4 : na, "Bear Rocket 5", shape.triangledown, location.absolute, f_rocketCol(4, bearTop, darkCol), size=size.tiny)
plotshape(bearOn and rocketCount >= 6 ? bearBase + dispAtr * rocketStep * 5 : na, "Bear Rocket 6", shape.triangledown, location.absolute, f_rocketCol(5, bearTop, darkCol), size=size.tiny)


// Exits: long exit marked above the bar, short exit below the bar (opposite side of the rocket)
plotshape(showExits and longExit,  "Bull Exit", shape.labeldown, location.abovebar, exitCol, textcolor=color.white, text="EXIT", size=size.tiny)
plotshape(showExits and shortExit, "Bear Exit", shape.labelup,   location.belowbar, exitCol, textcolor=color.white, text="EXIT", size=size.tiny)

//=====================================================================
// 8. ALERTS
//=====================================================================
alertcondition(longEntry,  "Bull Rocket Entry", "Engine bullish + Renko green: long entry")
alertcondition(shortEntry, "Bear Rocket Entry", "Engine bearish + Renko red: short entry")
alertcondition(longExit,   "Bull Exit", "Long exit")
alertcondition(shortExit,  "Bear Exit", "Short exit")

// ATR Readout
var atrTbl = table.new(position.top_right, 1, 1, bgcolor = color.new(color.black, 30), border_width = 0)
if barstate.islast
    table.cell(atrTbl, 0, 0, "ATR: " + (na(renkoAtr) ? "n/a" : str.tostring(renkoAtr, format.mintick)), text_color = color.white, text_size = size.normal)
