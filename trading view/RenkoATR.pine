//@version=6
indicator("Renko Supertrend Flip Signals", overlay=true)

brickSize = input.float(20.83, "Renko Brick Size", step=0.01)
stLen = input.int(7, "Supertrend ATR Length")
stFactor = input.float(4.0, "Supertrend Factor", step=0.1)

renkoTicker = ticker.renko(syminfo.tickerid, "Traditional", brickSize)

[renkoST, renkoDir] = request.security(renkoTicker, "1", ta.supertrend(stFactor, stLen), gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off)

bullFlip = renkoDir < 0 and renkoDir[1] > 0
bearFlip = renkoDir > 0 and renkoDir[1] < 0

plotshape(bullFlip, title="BUY", style=shape.triangleup, location=location.belowbar, color=color.green, size=size.small)
plotshape(bearFlip, title="SELL", style=shape.triangledown, location=location.abovebar, color=color.red, size=size.small)

if bullFlip
    alert("RENKO SUPERTREND BUY — Bullish flip", alert.freq_once_per_bar)

if bearFlip
    alert("RENKO SUPERTREND SELL — Bearish flip", alert.freq_once_per_bar)