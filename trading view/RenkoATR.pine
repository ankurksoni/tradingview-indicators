
 //@version=6
indicator("Adaptive Renko Supertrend Flip Signals", overlay=true, max_bars_back=5000)

// ───────── INPUTS ─────────
renkoMode = input.string("Automated ATR", "Renko Mode", options=["Automated ATR", "Manual Traditional"])
manualBrickSize = input.float(20.83, "Manual Brick Size", minval=0.01, step=0.01)

sourceTf = input.timeframe("360", "Auto Brick Source Timeframe")
sourceAtrLen = input.int(5, "Source Renko ATR Length", minval=1)
brickDivisor = input.float(12.0, "Auto Brick Divisor", minval=0.1, step=0.5)

// Renko Supertrend signal settings
renkoStLen = input.int(7, "Renko Supertrend ATR Length", minval=1)
renkoStFactor = input.float(4.0, "Renko Supertrend Factor", minval=0.1, step=0.1)

// Standard ATR Supertrend display settings
lineAtrLen = input.int(144, "ATR Line Length", minval=1)
lineFactor = input.float(15.0, "ATR Line Multiplier", minval=0.1, step=0.1)
fillTransparency = input.int(92, "Trend Fill Transparency", minval=0, maxval=100)

// ───────── AUTOMATIC BRICK SIZE ─────────
atrRenkoTicker = ticker.renko(syminfo.tickerid, "ATR", sourceAtrLen)

autoBrickCandidate = request.security(
     atrRenkoTicker,
     sourceTf,
     ta.valuewhen(close != close[1], math.abs(close - close[1]) / brickDivisor, 0),
     gaps=barmerge.gaps_off,
     lookahead=barmerge.lookahead_off)

brickSize = renkoMode == "Manual Traditional" ? manualBrickSize : autoBrickCandidate

var float activeBrickSize = na
if not na(brickSize) and brickSize > 0
    activeBrickSize := brickSize

// ───────── TOP-RIGHT BRICK SIZE DISPLAY ─────────
var table brickTable = table.new(position.top_right, 1, 2, border_width=1)

if barstate.islast
    if renkoMode == "Automated ATR"
        table.cell(
             brickTable, 0, 0, "Automated Brick Size",
             text_color=color.white, bgcolor=color.rgb(40, 40, 40))
        table.cell(
             brickTable, 0, 1,
             na(activeBrickSize) ? "Calculating..." : str.tostring(activeBrickSize, format.mintick),
             text_color=color.yellow, bgcolor=color.rgb(40, 40, 40))
    else
        table.clear(brickTable, 0, 0, 0, 1)

// ───────── CUSTOM RENKO + SUPERTREND ENGINE ─────────
var float renkoClose = na
var float renkoAtr = na
var float finalUpper = na
var float finalLower = na
var int renkoStDir = 1

bool bullFlip = false
bool bearFlip = false

if na(renkoClose) and not na(activeBrickSize)
    renkoClose := close

if not na(renkoClose) and not na(activeBrickSize)
    int processed = 0

    while processed < 100 and (
         close >= renkoClose + activeBrickSize or
         close <= renkoClose - activeBrickSize)

        float oldClose = renkoClose
        float newClose = close > oldClose ? oldClose + activeBrickSize : oldClose - activeBrickSize

        // Synthetic Renko brick range
        float brickHigh = math.max(oldClose, newClose)
        float brickLow = math.min(oldClose, newClose)
        float tr = math.max(
             brickHigh - brickLow,
             math.max(
                 math.abs(brickHigh - oldClose),
                 math.abs(brickLow - oldClose)))

        // Wilder ATR calculated on Renko bricks
        renkoAtr := na(renkoAtr) ? tr : renkoAtr + (tr - renkoAtr) / renkoStLen

        float midpoint = (brickHigh + brickLow) / 2.0
        float basicUpper = midpoint + renkoStFactor * renkoAtr
        float basicLower = midpoint - renkoStFactor * renkoAtr

        float previousUpper = finalUpper
        float previousLower = finalLower
        int previousDir = renkoStDir

        finalUpper := na(previousUpper) or basicUpper < previousUpper or oldClose > previousUpper ? basicUpper : previousUpper
        finalLower := na(previousLower) or basicLower > previousLower or oldClose < previousLower ? basicLower : previousLower

        // Supertrend direction: -1 bullish, +1 bearish
        if previousDir == 1 and newClose > finalUpper
            renkoStDir := -1
        else if previousDir == -1 and newClose < finalLower
            renkoStDir := 1

        // Signals only on Renko Supertrend flips
        if previousDir > 0 and renkoStDir < 0
            bullFlip := true
        else if previousDir < 0 and renkoStDir > 0
            bearFlip := true

        renkoClose := newClose
        processed += 1

// ───────── STANDARD ATR SUPERTREND (14, 5) ─────────
[lineST, lineDir] = ta.supertrend(lineFactor, lineAtrLen)

// Line and fill color follow Renko Supertrend direction.
trendColor = renkoStDir < 0 ? color.green : color.red

stPlot = plot(
     lineST,
     title="ATR Supertrend 14/5",
     color=trendColor,
     linewidth=2,
     style=plot.style_linebr)

// Hidden close plot used as the fill boundary.
pricePlot = plot(
     close,
     title="Fill Boundary",
     display=display.none)

// Light shading between candle close and ATR Supertrend.
fill(
     pricePlot,
     stPlot,
     color=color.new(trendColor, fillTransparency),
     title="Renko Trend Shading")

// ───────── BUY/SELL SIGNALS ─────────
plotshape(
     bullFlip,
     title="BUY",
     style=shape.triangleup,
     location=location.belowbar,
     color=color.green,
     size=size.small)

plotshape(
     bearFlip,
     title="SELL",
     style=shape.triangledown,
     location=location.abovebar,
     color=color.red,
     size=size.small)

// ───────── ALERTS ─────────
if bullFlip
    alert("RENKO SUPERTREND BUY — Bullish flip", alert.freq_once_per_bar)

if bearFlip
    alert("RENKO SUPERTREND SELL — Bearish flip", alert.freq_once_per_bar)

// ───────── DATA WINDOW ─────────
plot(activeBrickSize, "Active Brick Size", display=display.data_window)
