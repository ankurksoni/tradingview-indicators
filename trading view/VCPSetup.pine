//@version=6
indicator("VCP Setup", shorttitle="VCP-Setup", overlay=true, max_bars_back=500, max_labels_count=500)

import PineCoders/lower_tf/2 as PCltf

// ═══════════════════════════════════════════════════════════════
//  LTF STRING CONSTANTS  (must match PCltf.ltf() argument order)
// ═══════════════════════════════════════════════════════════════
string LTF1 = "Least precise, covering most chart bars"
string LTF2 = "Less precise, covering some chart bars"
string LTF3 = "More precise, covering less chart bars"
string LTF4 = "Most precise, 1min intrabars"
string LTF5 = "~12 intrabars per chart bar"
string LTF6 = "~24 intrabars per chart bar"
string LTF7 = "~50 intrabars per chart bar"
string LTF8 = "~100 intrabars per chart bar"

// ═══════════════════════════════════════════════════════════════
//  INPUTS
// ═══════════════════════════════════════════════════════════════

string G_CVD = "CVD Settings"
string i_ltfMode = input.string(LTF2, "Intrabar Precision", group=G_CVD,
     options=[LTF1, LTF2, LTF3, LTF4, LTF5, LTF6, LTF7, LTF8],
     tooltip="More precise = fewer chart bars covered (max 100K intrabars total). Matches CVD.pine setting.")

string G_SCAN = "Scan Conditions"
int   i_lookback  = input.int(75,    "Lookback Bars (~2.5 months on daily)", minval=20,  maxval=500,  group=G_SCAN,
     tooltip="On a daily chart ~55–75 bars ≈ 2.5 months.")
int   i_minDivs   = input.int(3,     "Min CVD Bullish Divergences",          minval=1,   maxval=50,   group=G_SCAN,
     tooltip="Minimum count of teal-candle (bullish intrabar CVD divergence) bars in the lookback window.")
float i_pctThresh = input.float(25.0,"Price Range % from High / Low",        minval=1.0, maxval=50.0, step=1.0, group=G_SCAN,
     tooltip="CMP must be within this % below the period high AND within this % above the period low simultaneously.") / 100
float i_bbwThresh = input.float(15.0,"Bollinger Bandwidth Threshold (<)",    minval=1.0, step=0.5,   group=G_SCAN,
     tooltip="Bollinger %Bandwidth = (Upper − Lower) / Basis × 100. Below 15 = tight consolidation.")

string G_VIS = "Visuals"
bool  i_darkMode   = input.bool(true,         "Dark Mode",                   group=G_VIS, tooltip="Enable for dark chart themes. Adjusts table, labels, and default colors.")
bool  i_colorSetup = input.bool(true,         "Highlight setup candles",     group=G_VIS)
color i_setupColor = input.color(color.new(#888888, 0), "Setup candle color", group=G_VIS)
color i_divDot     = input.color(color.rgb(red = 173, green = 238, blue = 179, transp = 50),  "CVD Div dot color",           group=G_VIS)
float i_arrowGap   = input.float(8.0, "CVD dot gap below candle (%)", minval=0.5, maxval=20.0, step=0.5, group=G_VIS,
     tooltip="How far below the bar low the CVD dot is drawn, as a % of the bar low price.") / 100
float i_rsGap      = input.float(9.0, "RS score/dot gap below candle (%)", minval=3.0, maxval=40.0, step=0.5, group=G_VIS,
     tooltip="How far below the bar low the RS score label and RS blue dot are drawn. Keep this larger than the CVD dot gap.") / 100
int   i_rsThresh   = input.int(80, "Show RS score only when ≥", minval=1, maxval=99, step=1, group=G_VIS,
     tooltip="RS score (0–100 percentile rank vs its own 52-week history) is only displayed when it meets or exceeds this value.")

bool  i_showTight      = input.bool(true,  "Highlight tight 3-bar zone",          group=G_VIS)
string i_tightStyle    = input.string("Line above chart", "Tight zone display style", options=["Circle", "Line above chart"], group=G_VIS,
     tooltip="Circle = gray circles behind candles. Line above chart = colored marker above the bar (like the RS line), so it doesn't interfere with candle reading.")
int   i_tightLookback  = input.int(10, "Tight zone lookback bars", minval=1, maxval=50, group=G_VIS,
     tooltip="Scan this many prior bars to find one whose high AND low are both within the tolerance % of the current candle's midpoint.")
float i_tightPct       = input.float(1.5, "Tight zone tolerance % from median", minval=0.1, maxval=20.0, step=0.1, group=G_VIS,
     tooltip="A lookback candle's high AND low must both be within this % of the current candle's midpoint (high+low)/2.") / 100
color i_tightColor     = input.color(color.new(color.yellow, 50), "Tight zone color", group=G_VIS)

string G_AVWAP = "AVWAP"
bool  i_showAvwap   = input.bool(false, "Show Anchored VWAP", group=G_AVWAP)
int   i_anchorDate  = input.time(timestamp("30 Mar 2026 00:00 +0000"), "Anchor Date", group=G_AVWAP)
color i_avwapColor  = input.color(color.new(color.orange, 50), "AVWAP Color", group=G_AVWAP)

string G_EMA = "EMAs"
bool  i_show10   = input.bool(true,                                   "Show 10 EMA",    inline="e10", group=G_EMA)
color i_ema10Clr = input.color(color.new(color.white, 5),            "",               inline="e10", group=G_EMA)
bool  i_show20   = input.bool(true,                                   "Show 20 EMA",    inline="e20", group=G_EMA)
color i_ema20Clr = input.color(color.new(color.yellow, 5),            "",               inline="e20", group=G_EMA)
bool  i_show50   = input.bool(true,                                   "Show 50 EMA",    inline="e50", group=G_EMA)
color i_ema50Clr = input.color(color.new(color.green, 5),            "",               inline="e50", group=G_EMA)
bool  i_show200  = input.bool(true,                                   "Show 200 EMA",   inline="e200", group=G_EMA)
color i_ema200Clr = input.color(color.new(color.red, 5),             "",               inline="e200", group=G_EMA)
bool  i_showRS   = input.bool(false,                     "Show RS line",   inline="rs",  group=G_EMA)
string i_idxSym  = input.symbol("NSE:NIFTYSMLCAP250",   "vs",             inline="rs",  group=G_EMA)
int   i_rsPeriod = input.int(20, "RS Period", minval=5, maxval=200,        inline="rs",  group=G_EMA)

string G_HLC = "HLC Bar Chart"
bool  i_showHlc     = input.bool(true,       "Show HLC Bar Chart",  group=G_HLC, tooltip="Overlay HLC bars (open=close) colored by close vs prior close, replacing the look of regular candles.")
color i_hlcBullClr  = input.color(#0097A7,    "Bullish Color",       group=G_HLC)
color i_hlcBearClr  = input.color(#EC407A,    "Bearish Color",       group=G_HLC)

string G_PRESS = "Minervini Pressure"
bool  i_showPressure  = input.bool(false, "Show pressure line at bottom of chart", group=G_PRESS)
int   i_pressLookback = input.int(20,     "Pressure lookback bars", minval=1, maxval=200, group=G_PRESS)
bool  i_pressWeighted = input.bool(false, "Body/range weighted",                group=G_PRESS,
     tooltip="Off = classic up-volume vs down-volume. On = volume weighted by candle body/range ratio.")

// ═══════════════════════════════════════════════════════════════
//  REAL CVD — identical intrabar logic to CVD.pine
//  Determines up/down volume for each intrabar candle.
// ═══════════════════════════════════════════════════════════════

upDnIntrabarVolumes() =>
    float upVol = 0.0
    float dnVol = 0.0
    float prevClose = nz(close[1])
    float prevUp    = nz(upVol[1])
    float prevDn    = nz(dnVol[1])
    if close > open
        upVol += volume
    else if close < open
        dnVol -= volume
    else if close > prevClose
        upVol += volume
    else if close < prevClose
        dnVol -= volume
    else if prevUp > 0
        upVol += volume
    else if prevDn < 0
        dnVol -= volume
    [upVol, dnVol]

var string ltfString = PCltf.ltf(i_ltfMode, LTF1, LTF2, LTF3, LTF4, LTF5, LTF6, LTF7, LTF8)

[upVolumes, dnVolumes] = request.security_lower_tf(syminfo.tickerid, ltfString, upDnIntrabarVolumes())

float totalUpVol = nz(array.sum(upVolumes))
float totalDnVol = nz(array.sum(dnVolumes))
float delta      = totalUpVol + totalDnVol   // positive = net buying, negative = net selling

// ─── Bullish divergence: green candle but net selling delta ───
// Price closed up (bulls won the bar) yet delta < 0 (sellers dominated intrabar flow).
// This means bulls absorbed heavy selling and still pushed price up — a sign of strength.
bool bullishCvdDiv = close > open and delta < 0

// ═══════════════════════════════════════════════════════════════
//  EMAs
// ═══════════════════════════════════════════════════════════════

float ema10  = ta.ema(close, 10)
float ema20  = ta.ema(close, 20)
float ema50  = ta.ema(close, 50)
float ema200 = ta.ema(close, 200)

// ═══════════════════════════════════════════════════════════════
//  ANCHORED VWAP
// ═══════════════════════════════════════════════════════════════

bool  _afterAnchor = time >= i_anchorDate
bool  _newAnchor   = _afterAnchor and not _afterAnchor[1]

var float _cumPV  = na
var float _cumVol = na

if _newAnchor
    _cumPV  := hlc3 * volume
    _cumVol := volume
else if _afterAnchor
    _cumPV  += hlc3 * volume
    _cumVol += volume

float anchoredVWAP = _afterAnchor ? _cumPV / _cumVol : na

// ═══════════════════════════════════════════════════════════════
//  RELATIVE STRENGTH vs BENCHMARK
// ═══════════════════════════════════════════════════════════════

float idxClose = request.security(i_idxSym, timeframe.period, close)
float stockChg = nz(close    / close[i_rsPeriod]    - 1, 0.0)
float idxChg   = nz(idxClose / idxClose[i_rsPeriod] - 1, 0.0)
bool  isOut    = stockChg > idxChg

// RS Line (ratio) used for 52-week high detection and percentile scoring
float rsLine       = nz(close / idxClose, 1.0)
// 52-week percentile rank: how strong this RS line is vs its own past year (0–100)
float rsScore      = math.round(ta.percentrank(rsLine, 252))
// RS Line new 52-week high: current value exceeds the max of the prior 252 bars
float _rs52wPrev    = ta.highest(rsLine, 252)[1]
bool  rsLineNewHigh = not na(_rs52wPrev) and rsLine >= _rs52wPrev

// ═══════════════════════════════════════════════════════════════
//  BOLLINGER %BANDWIDTH
//  Formula: (Upper − Lower) / Basis × 100
// ═══════════════════════════════════════════════════════════════

float bbBasis = ta.sma(close, 20)
float bbDev   = ta.stdev(close, 20)
float bbWidth = (4.0 * bbDev) / bbBasis * 100

// ═══════════════════════════════════════════════════════════════
//  PRICE RANGE CONDITIONS  (2.5-month rolling window)
// ═══════════════════════════════════════════════════════════════

float high2m5  = ta.highest(high, i_lookback)
float low2m5   = ta.lowest(low,   i_lookback)
bool  nearHigh = close >= high2m5 * (1.0 - i_pctThresh) and close <= high2m5
bool  nearLow  = close <= low2m5  * (1.0 + i_pctThresh) and close >= low2m5

// ═══════════════════════════════════════════════════════════════
//  DIVERGENCE COUNT IN LOOKBACK WINDOW
// ═══════════════════════════════════════════════════════════════

float divCount   = math.sum(bullishCvdDiv ? 1.0 : 0.0, int(i_lookback))
bool  enoughDivs = divCount >= i_minDivs

// ═══════════════════════════════════════════════════════════════
//  AGGREGATE SETUP CONDITION
// ═══════════════════════════════════════════════════════════════

bool aboveEma20  = close > ema20
bool bbwNarrow   = bbWidth < i_bbwThresh
bool setupActive = nearHigh and nearLow and enoughDivs and aboveEma20 and bbwNarrow

// ─── Tight 3-bar zone ─────────────────────────────────────────────
// Scans i_tightLookback prior bars; fires if ANY one has high AND low within ±i_tightPct of current midpoint.
// Additionally, the current candle must itself be within ±2×i_tightPct of the previous close.
float _candleMid = (high + low) / 2
bool  tightZone  = false
for _ti = 1 to i_tightLookback
    if math.abs(high[_ti] - _candleMid) / _candleMid <= i_tightPct and
       math.abs(low[_ti]  - _candleMid) / _candleMid <= i_tightPct
        tightZone := true
        break
tightZone := tightZone and math.abs(close - close[1]) / close[1] <= 2.0 * i_tightPct

// ─── Minervini Pressure ───────────────────────────────────────────
float _mpUpVol   = close > open ? volume : 0.0
float _mpDnVol   = close < open ? volume : 0.0
float _mpTotUp   = math.sum(_mpUpVol, i_pressLookback)
float _mpTotDn   = math.sum(_mpDnVol, i_pressLookback)

float _mpBodyWt  = (high - low) > 0 ? math.abs(close - open) / (high - low) : 0.0
float _mpWUpVol  = close > open ? volume * _mpBodyWt : 0.0
float _mpWDnVol  = close < open ? volume * _mpBodyWt : 0.0
float _mpWTotUp  = math.sum(_mpWUpVol, i_pressLookback)
float _mpWTotDn  = math.sum(_mpWDnVol, i_pressLookback)

float _pressure  = i_pressWeighted ?
     (_mpWTotUp + _mpWTotDn > 0 ? (_mpWTotUp - _mpWTotDn) / (_mpWTotUp + _mpWTotDn) * 100.0 : na) :
     (_mpTotUp  + _mpTotDn  > 0 ? (_mpTotUp  - _mpTotDn)  / (_mpTotUp  + _mpTotDn)  * 100.0 : na)

color _pressColor = _pressure > 30  ? color.green   :
                   _pressure > 0    ? color.lime  :
                   _pressure > -30  ? color.orange :
                   color.red

// ─── RS Blue Dot conditions ───────────────────────────────────────
// Forming a base: tight bandwidth while hugging the period high
bool formingBase  = bbwNarrow and nearHigh
// Breaking out of base: price just cleared the lookback-period high
bool breakingOut  = close > ta.highest(close, i_lookback)[1]
// Blue dot fires when RS Line hits a 52-week high AND stock is basing or breaking out
bool rsBlueDotCond = rsLineNewHigh and (formingBase or breakingOut)

// ═══════════════════════════════════════════════════════════════
//  VISUALS
// ═══════════════════════════════════════════════════════════════

// HLC Bar Chart — open plotted at close so bars render as HLC (not OHLC) candles.
color _hlcColor = close >= close[1] ? i_hlcBullClr : i_hlcBearClr
plotcandle(
     i_showHlc ? close : na,
     i_showHlc ? high  : na,
     i_showHlc ? low   : na,
     i_showHlc ? close : na,
     title="HLC Bars",
     color=_hlcColor,
     wickcolor=_hlcColor,
     bordercolor=_hlcColor
)

if bullishCvdDiv
    label.new(x=bar_index, y=low*(1.0-i_arrowGap), text="", style=label.style_circle, color=i_divDot, size=size.tiny)

// RS Score label — shown only on setup candles and the current (last) bar, when score ≥ threshold
bool onSetupOrLast = setupActive or barstate.islast
float _rsScoreY    = low * (1.0 - i_rsGap)               // score text: deepest
float _rsDotY      = low * (1.0 - i_rsGap * 0.6)         // blue dot: between CVD dot and score

if i_showRS and onSetupOrLast and rsScore >= i_rsThresh
    // Stack each character vertically to simulate 90° rotation
    string _rsRaw  = str.tostring(int(rsScore))
    string _rsVert = ""
    int    _rsLen  = str.length(_rsRaw)
    for i = 0 to _rsLen - 1
        _rsVert += str.substring(_rsRaw, i, i + 1) + (i < _rsLen - 1 ? "\n" : "")
    label.new(x=bar_index, y=low * (1.0 - i_rsGap * 3.5),
         text=_rsVert,
         style=label.style_none,
         textcolor=i_darkMode ? color.new(color.silver, 20) : color.new(color.gray, 40),
         size=size.large,
         text_font_family=font.family_monospace)

// RS Blue Dot — sky blue circle, on setup candles / current bar when conditions are met
color _rsBlue = color.rgb(0, 191, 255, 50)
if i_showRS and rsBlueDotCond and onSetupOrLast
    label.new(x=bar_index, y=_rsDotY,
         text="", style=label.style_circle,
         color=_rsBlue, size=size.small)

plot(i_show10  ? ema10  : na, "10 EMA",  i_ema10Clr,  linewidth=1)
plot(i_show20  ? ema20  : na, "20 EMA",  i_ema20Clr,  linewidth=1)
plot(i_show50  ? ema50  : na, "50 EMA",  i_ema50Clr,  linewidth=1)
plot(i_show200 ? ema200 : na, "200 EMA", i_ema200Clr, linewidth=1)
plot(i_showAvwap and timeframe.isdaily ? anchoredVWAP : na, "Anchored VWAP", i_avwapColor, linewidth=2)

color _rsClr = isOut ? color.new(color.green, 50) : color.new(color.red, 70)
plotshape(i_showRS     ? true : bool(na), "RS Line",            shape.square, location.top, _rsClr,    size=size.small)
plotshape(i_showPressure and not na(_pressure) ? true : bool(na), "Minervini Pressure", shape.square, location.bottom, _pressColor, size=size.small)

// Paint candles black only within the configured lookback window.
bool inWindow = bar_index >= last_bar_index - i_lookback
barcolor(i_colorSetup and setupActive and inWindow ? i_setupColor : na)

// Tight zone marker: either a circle behind each of the last 3 candles, or a line above the chart.
color _tightClrActual = i_darkMode ? color.new(#05f409, 0) : i_tightColor
bool inTightWindow = bar_index >= last_bar_index - i_tightLookback
bool _tightAsCircle = i_tightStyle == "Circle"
if i_showTight and _tightAsCircle and tightZone and inTightWindow
    label.new(x=bar_index,     y=(high     + low    ) / 2, text="", style=label.style_circle, color=_tightClrActual, size=size.huge)
    label.new(x=bar_index - 1, y=(high[1]  + low[1] ) / 2, text="", style=label.style_circle, color=_tightClrActual, size=size.huge)
    label.new(x=bar_index - 2, y=(high[2]  + low[2] ) / 2, text="", style=label.style_circle, color=_tightClrActual, size=size.huge)

plotshape(i_showTight and not _tightAsCircle and tightZone and inTightWindow ? true : bool(na),
     "Tight Zone Line", shape.flag, location.top, _tightClrActual, size=size.small)
